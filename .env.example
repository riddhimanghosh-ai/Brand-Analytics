# GitHub Configuration (for optional GitHub sync)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_username/Brand-Analytics
GITHUB_BRANCH=main

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Amplify Deployment (ngrok tunnel URL for local API access)
# Set this when deploying to Amplify to point to your local server
# Example: https://abc1234xyz.ngrok.io
NEXT_PUBLIC_API_URL=http://localhost:3000
