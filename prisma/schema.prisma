// Prisma schema for Analytics Dashboard (Prisma v6)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands Brand[]
}

model Brand {
  id        String   @id @default(cuid())
  userId    String
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Shopify
  shopifyStoreUrl    String?
  shopifyAccessToken String?

  // Google Analytics
  ga4PropertyId         String?
  ga4ServiceAccountJson String? // stored as JSON string

  // Meta Ads
  metaAppId       String?
  metaAppSecret   String?
  metaAccessToken String?
  metaAdAccountId String?

  // Google Ads
  googleAdsDevToken     String?
  googleAdsClientId     String?
  googleAdsClientSecret String?
  googleAdsRefreshToken String?
  googleAdsCustomerId   String?

  // AI
  geminiApiKey String?

  cachedMetrics CachedMetric[]
  chatSessions  ChatSession[]
  alerts        Alert[]
}

model CachedMetric {
  id         String   @id @default(cuid())
  brandId    String
  source     String   // shopify, ga4, meta_ads, google_ads
  metricType String   // kpi, chart, table
  metricKey  String   // e.g. "revenue_over_time", "top_products"
  value      String   // JSON stringified
  dateRange  String   // e.g. "7d", "30d", "90d"
  fetchedAt  DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, source, metricKey, dateRange])
}

model ChatSession {
  id        String   @id @default(cuid())
  brandId   String
  messages  String   // JSON stringified array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model Alert {
  id             String   @id @default(cuid())
  brandId        String
  metric         String
  previousValue  Float
  currentValue   Float
  changePercent  Float
  severity       String   // "warning" | "critical"
  detectedAt     DateTime @default(now())
  dismissed      Boolean  @default(false)
  dismissedAt    DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, detectedAt])
}
